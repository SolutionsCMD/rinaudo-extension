{
  "manifest_version": 3,
  "name": "Mizkif Global",
  "version": "1.207",
  "description": "Earn tickets for liking, commenting on, and watching Mizkif's posts and videos, and get pinged when he goes live or posts.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rinaudo-capital@jsolutions.dev",
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://rinaudoglobal.com/*",
    "https://s2.jsolutions.dev/*",
    "https://kick.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.tiktok.com/*",
    "https://m.tiktok.com/*",
    "https://www.instagram.com/*",
    "https://instagr.am/*",
    "https://instagram.com/*",
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://m.facebook.com/*",
    "https://www.reddit.com/*",
    "https://reddit.com/*",
    "https://old.reddit.com/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "optional_host_permissions": [
    "https://dashboard.kick.com/*"
  ],
  "background": {
    "scripts": [
      "config.js",
      "toast.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Mizkif Global"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://s2.jsolutions.dev/extension/connect*"
      ],
      "js": [
        "content/connect.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://kick.com/mizkif*"
      ],
      "js": [
        "config.js",
        "content/widget-frame.js",
        "vote/stake-panel.js",
        "content/guide-assets.js",
        "content/guide-hud.js",
        "content/kick.js",
        "content/kick-badges.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kick.com/popout/mizkif/*"
      ],
      "js": [
        "content/kick-badges.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "config.js",
        "content/widget-frame.js",
        "content/guide-assets.js",
        "content/guide-hud.js",
        "content/engage-core.js",
        "content/youtube.js",
        "content/grid-highlight.js",
        "content/yt-home-alert.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://m.tiktok.com/*"
      ],
      "js": [
        "config.js",
        "content/widget-frame.js",
        "content/guide-assets.js",
        "content/guide-hud.js",
        "content/engage-core.js",
        "content/tiktok.js",
        "content/grid-highlight.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://instagr.am/*"
      ],
      "js": [
        "config.js",
        "content/widget-frame.js",
        "content/guide-assets.js",
        "content/guide-hud.js",
        "content/engage-core.js",
        "content/instagram.js",
        "content/grid-highlight.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": [
        "config.js",
        "content/widget-frame.js",
        "content/guide-assets.js",
        "content/guide-hud.js",
        "content/engage-core.js",
        "content/facebook.js",
        "content/grid-highlight.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "config.js",
        "content/widget-frame.js",
        "content/guide-assets.js",
        "content/guide-hud.js",
        "content/engage-core.js",
        "content/x.js",
        "content/grid-highlight.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.tiktok.com/*",
        "https://m.tiktok.com/*",
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://instagr.am/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content/observe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.reddit.com/*",
        "https://reddit.com/*",
        "https://old.reddit.com/*"
      ],
      "js": [
        "config.js",
        "content/widget-frame.js",
        "content/guide-assets.js",
        "content/guide-hud.js",
        "content/engage-core.js",
        "content/reddit.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/dm-sans-latin.woff2"],
      "matches": ["https://kick.com/*", "https://dashboard.kick.com/*"]
    }
  ]
}
